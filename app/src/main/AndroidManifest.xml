<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="com.google.android.gms.common.service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.api.service.BIND_GEODATA_API" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.Service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.maps.API_KEY_REQUEST" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.common.telemetry.service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.common.internal.service.ICommonService" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.GMS_CHECKIN" />
        </intent>
        <!-- Added for Firestore/Auth broker resolution -->
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.Service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.auth.api.credentials.service.START" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

