<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout

    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:layoutDirection="rtl">

    <!-- 1. الهيدر العلوي المتوافق مع معايير RTL الحديثة -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#094A74"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="بدء مبادرة جديدة 💧"
            android:textColor="#094A74"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/user" />
    </RelativeLayout>

    <!-- بداية منطقة التمرير المستقلة -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:layout_above="@+id/layoutBottomButton"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 2. بطاقة الترحيب والتعريف الجمالية -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#0069B4"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="معاً نروي الحياة"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ابدأ مبادرة لتوزيع المياه في المناطق الأكثر احتياجاً في غزة."
                        android:textColor="#E0F2FE"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. حقل إدخال اسم المبادرة المربوط بالجافا -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم المبادرة"
                android:textColor="#094A74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/etInitiativeName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:hint="مثلاً: سقيا حي الشجاعية"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:inputType="text" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. حقل الحي المستهدف المربوط بالخريطة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الحي المستهدف"
                android:textColor="#094A74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#E2E8F0"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/spinner_target_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:hint="اختر المنطقة على الخريطة 📍"
                    android:textColorHint="#94A3B8"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- 5. كمية المياه المطلوبة والأزرار السريعة لتسهيل الإدخال -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كمية المياه المطلوبة (لتر)"
                android:textColor="#094A74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/etWaterAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:hint="أدخل كمية المياه بالأرقام"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:inputType="number" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn5k"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="5,000"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn10k"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="10,000"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn25k"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="25,000"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- 6. تحديد نوع التمويل المربوط براديو جروب في الجافا -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نوع التمويل"
                android:textColor="#094A74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/radioGroupFunding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbInternalFunding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تمويل مؤسساتي"
                    android:checked="true"
                    android:textColor="#1E293B"/>

                <RadioButton
                    android:id="@+id/rbCrowdFunding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تمويل جماعي"
                    android:textColor="#1E293B"/>
            </RadioGroup>

            <!-- حاويات برمجية لتفادي أخطاء استدعاء كود الجافا -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View android:id="@+id/layoutInternalFunding" android:layout_width="0dp" android:layout_height="0dp"/>
                <View android:id="@+id/layoutCrowdFunding" android:layout_width="0dp" android:layout_height="0dp"/>
            </FrameLayout>
            <!-- 7. البحث عن المزود واختياره التفاعلي -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اختر مزود الخدمة"
                android:textColor="#094A74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#94A3B8"/>
                    <EditText
                        android:id="@+id/etSearchProvider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="ابحث عن مزود خدمة..."
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp"
                        android:paddingHorizontal="8dp"
                        android:inputType="text"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- بطاقة المزود الأول -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProvider1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="2dp"
                app:strokeColor="#0069B4"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/tvProvider1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="شركة مياه غزة المركزية صهريج البلدية"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- بطاقة المزود الثاني -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProvider2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/tvProvider2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="الوفاق لنقل المياه صهريج الجنوب"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- 8. الحاوية السفلى الثابتة (التكلفة وزر التثبيت) -->
    <LinearLayout
        android:id="@+id/layoutBottomButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التكلفة التقديرية للمبادرة:"
                android:textColor="#64748B"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvEstimatedCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ₪"
                android:textColor="#0069B4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishInitiative"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="نشر وتأكيد المبادرة 💧"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#0069B4"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</RelativeLayout>

