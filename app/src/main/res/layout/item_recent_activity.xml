<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp"
    android:layoutDirection="rtl">
    <View
        android:id="@+id/viewTimelineLine"
        android:layout_width="2dp"
        android:layout_height="80dp"
        android:layout_alignParentRight="true"
        android:layout_marginRight="35dp"
        android:background="#E2E8F0" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActivityIconContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentRight="true"
        android:layout_marginRight="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#0369A1"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/imgActivityIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/sure"
            app:tint="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/cardActivityIconContainer"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="right">


        <TextView
            android:id="@+id/tvActivityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تمت الموافقة على توزيع 5000 لتر في منطقة الرمال"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvActivityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="منذ 5 دقائق • بواسطة يوسف م."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</RelativeLayout>