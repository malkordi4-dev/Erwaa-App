<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:orientation="horizontal"
            android:gravity="right|center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#D6E4FF"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgProviderIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#005B94" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginRight="8dp"
                android:gravity="right">

                <TextView
                    android:id="@+id/tvProviderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مياه العذب والصفاء"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvProviderType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="شبكة آبار"
            android:textColor="#475569"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvProviderLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="الرياض، حي النرجس"
            android:textColor="#475569"
            android:textSize="11sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center">

            <TextView
                android:id="@+id/tvProviderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● معتمد"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#D1FAE5"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- 5. عمود الإجراءات (زر التفاصيل) -->
        <TextView
            android:id="@+id/btnDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="التفاصيل"
            android:textColor="#005B94"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

</LinearLayout>