<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#F8FAFC"
    android:layoutDirection="rtl">

    <!-- لعمل شريط ملون على طرف الكرت (يسار أو يمين حسب التصميم، هنا وضعناه في اليمين) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- الخط الملون الرأسي على الحافة اليمنى -->
        <View
            android:id="@+id/viewTaskPriorityIndicator"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="#EF4444" /> <!-- يتغير لونه برمجياً حسب نوع المهمة -->

        <!-- الأيقونة المخصصة للمهمة -->
        <ImageView
            android:id="@+id/imgTaskIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_toLeftOf="@id/viewTaskPriorityIndicator"
            android:layout_marginRight="12dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/stat_notify_error"
            app:tint="#EF4444" /> <!-- يتغير لونها وشكلها برمجياً -->

        <!-- النصوص (العنوان والوصف) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/imgTaskIcon"
            android:layout_marginRight="12dp"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مراجعة طلب مزود جديد"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محطة التحلية المركزية"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>