<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layoutDirection="rtl">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/layoutCardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRequestTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="منذ ساعتين"
                android:textColor="#94A3B8"
                android:textSize="12sp" />


            <TextView
                android:id="@+id/tvRequestTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParent="true"
                android:layout_centerVertical="true"
                android:text="تصريح بئر"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#E0F2FE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/layoutRequestDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutCardHeader"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:gravity="right">

            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مؤسسة النهضة للمياه"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRequestDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلب تجديد تصريح بئر ارتوازي - منطقة القصيم"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutRequestDetails"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:text="اعتماد"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:insetTop="0dp"
                app:insetBottom="0dp"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReview"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:backgroundTint="#005B94"
                android:text="مراجعة"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:insetTop="0dp"
                app:insetBottom="0dp"/>



        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>